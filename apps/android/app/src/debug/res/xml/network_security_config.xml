<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: cleartext to the host machine's dev server, as the emulator's host (10.0.2.2) or through
     `adb reverse` on loopback (127.0.0.1, used for signing in: docs/mobile.md, Phase 11).
     This replaces the file of rustls-platform-verifier, so the core's HTTPS check cannot fetch CRLs: debug builds
     reach https servers only if their certificate names an OCSP responder. Release builds keep the library's file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
