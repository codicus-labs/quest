<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview (Android 12+): sample hours and tasks in Quest's colours. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_day"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:text="@string/widget_preview_hours"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:text="@string/widget_preview_task_1"
        android:textColor="@color/widget_text"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:text="@string/widget_preview_task_2"
        android:textColor="@color/widget_text"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:text="@string/widget_preview_task_3"
        android:textColor="@color/widget_faint"
        android:textSize="14sp" />
</LinearLayout>
